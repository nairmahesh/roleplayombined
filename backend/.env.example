# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pitchiq

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_AGENT_ID is optional — if omitted, one default agent is auto-created
# on first request and its ID is logged to console. Copy it here to reuse across restarts.
# ELEVENLABS_AGENT_ID=

# S3 — for storing session recordings
# Supports AWS S3 and any S3-compatible service (MinIO, Backblaze B2, Cloudflare R2, etc.)
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_ENDPOINT=https://... # Only needed for non-AWS S3 (MinIO, R2, B2, etc.)

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
