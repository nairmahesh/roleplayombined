# PitchIQ Frontend — Environment Variables
# Copy this file to .env and fill in your values

# API base URL — must point to the backend server's /api prefix.
# In development this is proxied via Vite (leave blank or set to /api).
# In production set the full URL, e.g. https://api.pitchiq.com/api
VITE_API_URL=http://localhost:4000/api
